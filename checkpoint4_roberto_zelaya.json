            "Session_ID": "={{ $('06 - Set: datos mínimos').first().json.From }}",
            "Fecha de actualización": "={{ new Date().toISOString() }}",
            "Resumen consolidado": "={{ (() => {\n  const m = $('03 - Memoria: buscar sesión').first().json || {};\n  const datos = JSON.parse(m['Datos clave'] || '{}');\n  const contador = Number(datos.turnos_desde_resumen || 0);\n  const previo = String(m['Resumen consolidado'] || '');\n\n  if (contador < 5) return previo;\n\n  const texto = String($('05 - Agente Worker: redactar').first().json.output || '')\n    .replace(/^```(?:json)?\\s*/i, '')\n    .replace(/\\s*```$/, '').trim();\n\n  const o = JSON.parse(texto);\n  const actual = [\n    o.asunto_principal,\n    ...(Array.isArray(o.puntos_clave) ? o.puntos_clave : []).slice(0, 3),\n    o.accion_requerida\n  ].filter(Boolean).map(x => String(x).slice(0, 160)).join(' | ');\n\n  const pendientes = Array.isArray(datos.pendientes) ? datos.pendientes : [];\n\n  return [previo, ...pendientes, actual]\n    .filter(Boolean).join('\\n').slice(-6000);\n})() }}\n\n",
            "Estado del caso": "={{ 'en curso' }}",
            "Datos clave": "={{ (() => {\n  const m = $('03 - Memoria: buscar sesión').first().json || {};\n  const datos = JSON.parse(m['Datos clave'] || '{}');\n\n  const texto = String($('05 - Agente Worker: redactar').first().json.output || '')\n    .replace(/^```(?:json)?\\s*/i, '')\n    .replace(/\\s*```$/, '').trim();\n\n  const o = JSON.parse(texto);\n  const nota = [\n    o.asunto_principal,\n    ...(Array.isArray(o.puntos_clave) ? o.puntos_clave : []).slice(0, 3),\n    o.accion_requerida\n  ].filter(Boolean).map(x => String(x).slice(0, 160)).join(' | ');\n\n  const n = Number(datos.turnos_desde_resumen || 0);\n  const pendientes = Array.isArray(datos.pendientes) ? datos.pendientes : [];\n\n  return JSON.stringify({\n    ...datos,\n    turnos_desde_resumen: (n + 1) % 6,\n    pendientes: n >= 5 ? [] : [...pendientes, nota].slice(-5)\n  });\n})() }}\n\n"
